
configuration {
    modi: "drun,run";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "Apps";
    display-run: "Run";
    drun-display-format: "{name}";
    disable-history: false;
    hover-select: false;
}

* {
    bg:       #242933;
    surface:  #353C4A;
    selected: #3B4252;
    text:     #ECEFF4;
    muted:    #AAB3C5;
    accent:   #88C0D0;

    background-color: transparent;
    text-color: @text;
}

window {
    width: 620px;
    padding: 22px;
    border: 2px;
    border-color: #414B5D;
    border-radius: 18px;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
    background-color: @bg;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 14px 16px;
    border: 1px;
    border-color: #454D5D;
    border-radius: 12px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Search apps...";
    placeholder-color: @muted;
    cursor: text;
    background-color: transparent;
    text-color: @text;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 6px;
    cycle: false;
    dynamic: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 11px 12px;
    spacing: 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 10px;
    background-color: transparent;
    text-color: @text;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @selected;
    border-color: #4C6575;
    text-color: @accent;
}

element alternate.normal {
    background-color: #292F3A;
    text-color: @text;
}

element-icon {
    size: 24px;
    cursor: inherit;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
